{
  "name": "servicebeat",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "infra:up": "docker compose up postgres redis pgadmin -d",
    "infra:down": "docker compose down",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "prisma migrate dev",
    "db:migrate:docker": "docker run --rm --network servicebeat_default -e DATABASE_URL=postgresql://servicebeat:servicebeat@postgres:5432/servicebeat servicebeat-worker npx prisma migrate dev",
    "db:generate": "prisma generate",
    "seed": "tsx src/scripts/seed.ts",
    "seed:docker": "docker run --rm --network servicebeat_default --env-file .env -e DATABASE_URL=postgresql://servicebeat:servicebeat@postgres:5432/servicebeat servicebeat-worker npx tsx src/scripts/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4.3.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.7",
    "jsonpath-plus": "^10.4.0",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.14",
    "prisma": "^5.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonpath": "^0.2.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.5",
    "pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
